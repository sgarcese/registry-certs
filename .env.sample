# Copy to .env for local development. In AWS, plain config comes from the ECS
# task definition (terraform/envs/*) and secrets from Secrets Manager.

# --- Database (names are historical; see server/lib/app-services.ts) ---
# Leave REGISTRY_DATA_DB_SERVER empty to run with the fixture-backed in-memory
# fake instead of SQL Server.
REGISTRY_DATA_DB_SERVER=localhost
REGISTRY_DATA_DB_DATABASE=RegistryCommerce
REGISTRY_DATA_DB_USER=registry_app
REGISTRY_DATA_DB_PASSWORD=LocalDev!AppPassw0rd
ENCRYPT_DB_CONNECTION=true

# Admin credentials for db/migrate.ts (docker-compose SA locally; the RDS
# master secret in CI).
DB_ADMIN_USER=sa
DB_ADMIN_PASSWORD=LocalDev!Passw0rd

# --- Integration drivers: stub | real ---
# payments: stub | stripe   email: log | postmark   contact form: stub | bostongov
PAYMENTS_DRIVER=stub
EMAIL_DRIVER=log
CONTACT_FORM_DRIVER=stub

# Required even in stub mode: simulated webhooks are HMAC-signed and verified
# (fail closed). Generate any random string for local dev.
STRIPE_WEBHOOK_SECRET=whsec_local_dev_secret

# Only needed when PAYMENTS_DRIVER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Only needed when EMAIL_DRIVER=postmark
POSTMARK_SERVER_API_TOKEN=

# Only needed when CONTACT_FORM_DRIVER=bostongov
CONTACTFORM_TOKEN=
CONTACTFORM_CONTENT_TYPE=application/x-www-form-urlencoded

# --- API keys (X-API-KEY header). GraphQL fails closed: with none configured
# every request is rejected unless ALLOW_UNAUTHENTICATED_GRAPHQL=1 (dev only).
API_KEYS=local-dev-key
WEB_API_KEY=local-dev-web-key
FULFILLMENT_API_KEY=local-dev-fulfillment-key
# ALLOW_UNAUTHENTICATED_GRAPHQL=1
# ALLOW_FULFILLMENT_BYPASS=1

# --- Feature flags / misc ---
MARRIAGE_CERTS_ENABLED=1
ROOT_REDIRECT_URL=/birth
# ROLLBAR_ACCESS_TOKEN=
# ROLLBAR_ENVIRONMENT=development
